# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local orchestration scratch files
/work/

# local verification reports and other generated deliverables
/outputs/

# local-only recording guide; do not publish it with the project submission
/docs/DEMO_SCRIPT.md

# local formal-board single-instance data (accounts, sessions, activities)
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
